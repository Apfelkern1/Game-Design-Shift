  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShiftPrototype.ShiftHUD
  world: {fileID: 906949101}
  roomNames:
  - 01 / Zeitwechsel
  - 02 / Spruenge
  - 03 / Praezise Spruenge
  hints:
  - Springe ueber den Block. E wechselt die Zeit und oeffnet den Weg. Erreiche das helle Tor rechts.
  - Springe mit Anlauf ueber die Luecke. E entfernt die Fabrikwand. Gelb = Checkpoint.
  - Halte Leertaste fuer hohe Spruenge ueber die Stufen. Oben hilft E.
